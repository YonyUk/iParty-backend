<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="FluentAssertions" Version="8.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Respawn" Version="7.0.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.11.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Services\Users\Infrastructure\UsersInfrastructure.csproj" />
    <ProjectReference Include="..\..\..\Services\Users\Application\UsersApplication.csproj" />
    <ProjectReference Include="..\..\..\Services\Users\Domain\UsersDomain.csproj" />
    <ProjectReference Include="..\..\..\Services\Users\API\UsersApi.csproj" />
  </ItemGroup>

  <Target Name="RenameDepsFileForWebApplicationFactory" AfterTargets="Build">
    <ItemGroup>
      <DepsFile Include="$(OutputPath)$(AssemblyName).deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(DepsFile)" DestinationFiles="$(OutputPath)testhost.deps.json" Condition="Exists('@(DepsFile)')" />
  </Target>

</Project>
