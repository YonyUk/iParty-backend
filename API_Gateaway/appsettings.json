{
  "Security": {
    "Jwt": {
      "SecretKey": "your_super_secret_key_for_the_api_users_authentication_and_user_authorization_on_jwt",
      "Issuer": "http://localhost:5129",
      "Audience": "http://localhost:5129/swagger",
      "ExpiresMinutes": 5
    }
  },
  "ReverseProxy": {
    "Routes": {
      "users-me-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/users/me"
        },
        "AuthorizationPolicy": "Authenticated",
        "Transforms": [
          {
            "PathPattern": "/api/users/me"
          }
        ]
      },
      "login-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/users/login"
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          {
            "PathPattern": "/api/users/login"
          }
        ]
      },
      "register-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/users/register"
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms":[
          {
            "PathPattern":"/api/users/register"
          }
        ]
      },
      "logout-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/users/logout"
        },
        "AuthorizationPolicy": "Authenticated",
        "Transforms": [
          {
            "PathPattern": "/api/users/logout"
          }
        ]
      },
      "public-get-user": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/users/{userId}"
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms":[
          {
            "PathPattern":"/api/users/{userId}"
          }
        ]
      },
      "public-get-users":{
        "ClusterId": "users-cluster",
        "Match":{
          "Path":"/users"
        },
        "AuthorizationPolicy":"anonymous",
        "Transforms":[
          {
            "PathPattern":"/api/users"
          }
        ]
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "users-dest": {
            "Address": "http://localhost:5000"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimitOptions": {
    "Limit": 100,
    "TimeSpanLimit": 1,
    "QueueLimit": 10
  }
}