{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "GlobalPrefix": "api/v1"
  },
  "UsersDomain": {
    "MinimumUserNameLength": 6,
    "MaximumUserNameLength": 100,
    "MinimumPasswordLength": 8,
    "MaximumPasswordLength": 50
  },
  "Database": {
    "Schema": "public",
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=iPartyUsersDB;Username=postgres;Password=your_db_password"
  },
  "Security":{
    "Jwt":{
      "SecretKey":"",
      "Issuer":"http://localhost:8080",
      "Audience":"http://localhost:8080/swagger",
      "ExpiresMinutes":5
    }
  }
}