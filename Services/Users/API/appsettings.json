{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "GlobalPrefix": "api/v1"
  },
  "UsersDomain": {
    "MinimumUserNameLength": 6,
    "MaximumUserNameLength": 100,
    "MinimumPasswordLength": 8,
    "MaximumPasswordLength": 50
  },
  "Database": {
    "Schema": "public",
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=your_host;Port=your_port;Database=your_db;Username=your_user;Password=your_password"
  },
  "Security":{
    "Jwt":{
      "SecretKey":"your_super_secret_key_for_the_api_users_authentication_and_user_authorization_on_jwt",
      "Issuer":"http://localhost:8080",
      "Audience":"http://localhost:8080/swagger",
      "ExpiresMinutes":5
    }
  }
}